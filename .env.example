# ==============================================================================
# LessonGen Free-Tier Environment Configuration
# ==============================================================================

# Generator, Planner, and Reflector Model (Google Gemini Free Tier)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEN_MODEL=gemini-2.5-flash

# Independent Judge Model (Groq Free Tier - avoids self-grading bias)
# Get your free key at: https://console.groq.com/
# Recommended fast free model: llama-3.1-8b-instant (or llama-3.3-70b-versatile)
GROQ_API_KEY=your_groq_api_key_here
JUDGE_MODEL=llama-3.1-8b-instant

# Optional Fallback: Ollama Local Model URL (if running locally without internet)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Execution Settings
CACHE_ENABLED=true
CACHE_DIR=.cache/llm
MAX_RETRIES=2
RATE_LIMIT_DELAY_SECONDS=2.0
